---
import { byNewest } from '../../lib/posts';
import ListPage from '../../components/ListPage.astro';
import { getCollection } from 'astro:content';
import { LOCATION_INTRO } from '../../lib/intros';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const locations = [...new Set(allPosts.map((p) => p.data.location).filter(Boolean))];
  return locations.map((location) => ({ params: { location } }));
}

const { location } = Astro.params;
const allPosts = await getCollection('posts');
const posts = allPosts.filter((p) => p.data.status !== '待填' && p.data.location === location).sort(byNewest);
---
<ListPage title={location} eyebrow="地點" intro={LOCATION_INTRO[location]} pillar={{ href: '/art-field/', text: '大地藝術祭 2027 攻略' }} posts={posts} canonicalPath={`/location/${location}/`} />
