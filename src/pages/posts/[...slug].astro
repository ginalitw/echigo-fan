---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const prevPost = post.data.prevSlug ? await getEntry('posts', post.data.prevSlug) : null;
const nextPost = post.data.nextSlug ? await getEntry('posts', post.data.nextSlug) : null;
---
<Layout title={`${post.data.title} - 越後飯`}>
  <div class="article">
    <div class="kicker">
      {post.data.category.map((c, i) => (
        <>{i > 0 && ' · '}<a href={`/category/${encodeURIComponent(c)}`}>{c}</a></>
      ))}
      {post.data.location && (<> · <a href={`/location/${encodeURIComponent(post.data.location)}`}>{post.data.location}</a></>)}
      {post.data.artworkNumber && <> · <span class="code">{post.data.artworkNumber}</span></>}
      {post.data.season && post.data.season.map(s => (
        <> · <a href={`/season/${encodeURIComponent(s)}`}>{s}</a></>
      ))}
      {post.data.artist && post.data.artist.length > 0 && (
        <> · {post.data.artist.map((a, i) => (
          <>{i > 0 && '、'}<a href={`/artist/${encodeURIComponent(a)}`}>{a}</a></>
        ))}</>
      )}
    </div>
    <h1>{post.data.title}</h1>
    {post.data.artworkName && <div class="artwork-name">{post.data.artworkName}</div>}
    {post.data.lead && <div class="lead">{post.data.lead}</div>}
    <Content />
    <div class="article-nav">
      <span>{prevPost ? <a href={`/posts/${prevPost.slug}`}>◀ 上一站：{prevPost.data.title}</a> : <a href="/">◀ 回首頁</a>}</span>
      <span>{nextPost ? <a href={`/posts/${nextPost.slug}`}>下一站：{nextPost.data.title} ▶</a> : <a href="/">回首頁 ▶</a>}</span>
    </div>
  </div>
</Layout>
