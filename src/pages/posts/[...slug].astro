---
import { url } from '../../lib/url';
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// 原文網址：拿來當 canonical，也印在文末的署名區塊裡。
// 被整篇搬走時，這行是最直接的出處證明。
const canonical = new URL(url(`/posts/${post.slug}`), Astro.site).href;

const prevPost = post.data.prevSlug ? await getEntry('posts', post.data.prevSlug) : null;
const nextPost = post.data.nextSlug ? await getEntry('posts', post.data.nextSlug) : null;
---
<Layout title={`${post.data.title} - 越後飯`} canonical={canonical}>
  <div class="article">
    <div class="kicker">
      {post.data.category.map((c, i) => (
        <>{i > 0 && ' · '}<a href={url(`/category/${encodeURIComponent(c)}`)}>{c}</a></>
      ))}
      {post.data.location && (<> · <a href={url(`/location/${encodeURIComponent(post.data.location)}`)}>{post.data.location}</a></>)}
      {post.data.artworkNumber && <> · <span class="code">{post.data.artworkNumber}</span></>}
      {post.data.season && post.data.season.map(s => (
        <> · <a href={url(`/season/${encodeURIComponent(s)}`)}>{s}</a></>
      ))}
      {post.data.artist && post.data.artist.length > 0 && (
        <> · {post.data.artist.map((a, i) => (
          <>{i > 0 && '、'}<a href={url(`/artist/${encodeURIComponent(a)}`)}>{a}</a></>
        ))}</>
      )}
    </div>
    <h1>{post.data.title}</h1>
    {post.data.artworkName && <div class="artwork-name">{post.data.artworkName}</div>}
    {post.data.lead && <div class="lead">{post.data.lead}</div>}
    <Content />

    {post.data.stamps && post.data.stamps.length > 0 && (
      <div class="stamps">
        <div class="stamps-label">蓋到的章</div>
        <div class="stamps-row">
          {post.data.stamps.map((src, i) => (
            <img src={url(src)} alt={`${post.data.title} 紀念章 ${i + 1}`} loading="lazy" />
          ))}
        </div>
      </div>
    )}

    <div class="repost-notice">
      <p>本文原載於 <strong>越後飯 ECHIGO FAN</strong> ——「追過了，才帶你去」</p>
      <p class="src">原文網址：<a href={canonical}>{canonical}</a></p>
      <p class="terms">歡迎分享連結。轉載請註明出處並保留原文連結，勿整篇複製。</p>
    </div>

    <div class="article-nav">
      <span>{prevPost ? <a href={url(`/posts/${prevPost.slug}`)}>◀ 上一站：{prevPost.data.title}</a> : <a href={url('/')}>◀ 回首頁</a>}</span>
      <span>{nextPost ? <a href={url(`/posts/${nextPost.slug}`)}>下一站：{nextPost.data.title} ▶</a> : <a href={url('/')}>回首頁 ▶</a>}</span>
    </div>
  </div>
</Layout>
