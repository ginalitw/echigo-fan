---
import { url } from '../../lib/url';
import { byNewest, formatDate } from '../../lib/posts';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const artistSet = new Set();
  allPosts.forEach(p => {
    if (p.data.artist) p.data.artist.forEach(a => artistSet.add(a));
  });
  return [...artistSet].map(artist => ({ params: { artist } }));
}

const { artist } = Astro.params;
const allPosts = await getCollection('posts');
const posts = allPosts.filter(p => p.data.status !== '待填' && p.data.artist && p.data.artist.includes(artist)).sort(byNewest);
---
<Layout title={`${artist} - 越後飯`}>
  <div class="section-label">🎨 {artist}</div>
  <div class="posts">
    {posts.map(post => (
      <a class="post-row" href={url(`/posts/${post.slug}`)}>
        <div class="meta">
          {post.data.date && <span class="date">{formatDate(post.data.date)}</span>}
          {post.data.season && post.data.season.length > 0 && <span class="season">{post.data.season[0]}</span>}
          {post.data.location && <span class="loc">{post.data.location}</span>}
          {post.data.artworkNumber && <span class="code">{post.data.artworkNumber}</span>}
        </div>
        <div class="body">
          <h4>{post.data.title}</h4>
          <p>{post.data.lead}</p>
        </div>
      </a>
    ))}
    {posts.length === 0 && <p style="text-align:center;color:var(--ink-soft);padding:40px 0">這位藝術家還沒有文章</p>}
  </div>
  <p style="text-align:center;margin-top:20px"><a href={url('/')} style="color:var(--gold);font-size:13px">◀ 回首頁</a></p>
</Layout>
