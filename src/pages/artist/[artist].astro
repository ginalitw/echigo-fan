---
import { byNewest } from '../../lib/posts';
import ListPage from '../../components/ListPage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const artists = new Set();
  allPosts.forEach((p) => p.data.artist?.forEach((a) => artists.add(a)));
  return [...artists].map((artist) => ({ params: { artist } }));
}

const { artist } = Astro.params;
const allPosts = await getCollection('posts');
const posts = allPosts.filter((p) => p.data.status !== '待填' && p.data.artist?.includes(artist)).sort(byNewest);
---
<ListPage title={artist} eyebrow="藝術家" posts={posts} canonicalPath={`/artist/${artist}/`} />
