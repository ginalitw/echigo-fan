---
import { byNewest } from '../../lib/posts';
import ListPage from '../../components/ListPage.astro';
import { getCollection } from 'astro:content';

const INTRO = {
  '越後大地藝術祭': '越後妻有的作品、路線、官方一日遊——我實際走過的部分。',
  '富士搖滾二三事': '舞台之外的筆記與見聞。跟生存攻略不是同一種文。',
  '我吃的不只是飯': '米、酒、山菜、車站便當。吃過才寫。',
  '里山人文和風土': '雪、織物、土地的故事。查得到的知識，我用自己的方式消化。',
};

export async function getStaticPaths() {
  return Object.keys({
    '越後大地藝術祭': 1, '富士搖滾二三事': 1, '我吃的不只是飯': 1, '里山人文和風土': 1,
  }).map((category) => ({ params: { category } }));
}

const { category } = Astro.params;
const allPosts = await getCollection('posts');
const posts = allPosts.filter((p) => p.data.status !== '待填' && p.data.category.includes(category)).sort(byNewest);
---
<ListPage
  title={category}
  eyebrow="四個方向"
  intro={INTRO[category]}
  posts={posts}
  canonicalPath={`/category/${category}/`}
  emptyText="這一區正在寫，踩點回來就會上。"
/>
