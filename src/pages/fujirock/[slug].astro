---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';
import { ARTICLES, STAGE_LABEL, displayTitle, articleFromEntry } from '../../lib/frf';
import { FRF_BODIES } from '../../lib/frf-bodies';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const synced = await getCollection('frf');
  if (synced.length) {
    return synced.map((entry) => ({ params: { slug: entry.slug } }));
  }
  return ARTICLES.filter((a) => a.published).map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry('frf', slug);
const fallback = ARTICLES.find((a) => a.slug === slug);
const article = entry ? articleFromEntry(entry) : fallback;
if (!article) throw new Error('not found');

const rendered = entry ? await entry.render() : null;
const Content = rendered?.Content;
const body = Content ? null : FRF_BODIES[article.slug];
const stageLabel = article.stage ? STAGE_LABEL[article.stage] : '';
const canonical = new URL(`/fujirock/${article.slug}/`, Astro.site).href;
const audienceLabel = article.audience.includes('beginner')
  ? '新手首衝'
  : article.audience.includes('returner')
    ? '老手升級'
    : article.audience.includes('start')
      ? '開始之前'
      : '通用必修';
const h1 = displayTitle(article.title);
const kicker = [article.n ? `#${article.n}` : '', audienceLabel, stageLabel].filter(Boolean).join(' · ');
---
<Layout
  theme="frf"
  title={`${h1}｜富士搖滾攻略｜越後飯`}
  description={article.meta}
  canonical={canonical}
  ogImage={article.image}
>
  <p class="frf-crumb">
    <a href={url('/fujirock/')}>← 攻略入口</a>
    {stageLabel && <span> / {stageLabel}</span>}
  </p>
  <p class="frf-kicker">{kicker}</p>
  <h1 class="frf-title">{h1}</h1>
  {article.meta && <p class="frf-lead">{article.meta}</p>}

  {Content ? (
    <article class="frf-prose">
      <Content />
    </article>
  ) : body ? (
    <article class="frf-prose" set:html={body} />
  ) : (
    <p class="frf-callout tip">這篇摘要已上線。全文會在下次 Notion 同步時進來。</p>
  )}

  <aside class="frf-repost">
    <p>本文原載於 <strong>越後飯 ECHIGO FAN</strong> —— 富士搖滾攻略</p>
    <p>原文網址：<a href={canonical}>{canonical}</a></p>
    <p class="terms">歡迎分享連結。轉載請註明出處並保留原文連結，勿整篇複製。</p>
  </aside>
</Layout>
