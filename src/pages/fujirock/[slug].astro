---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';
import {
  STAGE_LABEL,
  TOPICS,
  displayTitle,
  articleFromEntry,
  relatedFrom,
  isReturnerOnly,
} from '../../lib/frf';
import { FRF_BODIES } from '../../lib/frf-bodies';
import { getCollection, getEntry } from 'astro:content';
import { articleLd, toISODate } from '../../lib/seo';
import { extractFaq, faqLd } from '../../lib/faq';

export async function getStaticPaths() {
  const synced = await getCollection('frf');
  return synced.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry('frf', slug);
if (!entry) throw new Error('not found');
const article = articleFromEntry(entry);

const synced = await getCollection('frf');
const list = synced.map(articleFromEntry);
const related = relatedFrom(list, article.slug);
const topic = TOPICS.find((t) => t.id === article.topic);
const showUpgrade = isReturnerOnly(article);

const rendered = await entry.render();
const Content = rendered?.Content;
const body = Content ? null : FRF_BODIES[article.slug];
const stageLabel = article.stage ? STAGE_LABEL[article.stage] : '';
const canonical = new URL(`/fujirock/${article.slug}/`, Astro.site).href;
const h1 = displayTitle(article.title);

const updated = entry.data.updated;
const updatedISO = updated ? toISODate(updated) : null;

// 這篇如果是 Q&A 體，就順便輸出 FAQPage。抓不到配對會回 null，不硬湊。
const faq = faqLd(extractFaq(entry.body ?? ''));

const ld = [
  articleLd({
    headline: h1,
    canonical,
    description: article.meta,
    image: article.image,
    updated,
    section: topic?.title ?? '富士搖滾攻略',
  }),
  faq,
].filter(Boolean);
---
<Layout
  theme="frf"
  title={`${h1}｜富士搖滾攻略｜越後飯`}
  description={article.meta}
  canonical={canonical}
  ogImage={article.image}
  jsonLd={ld}
>
  <p class="frf-crumb">
    <a href={url('/fujirock/')}>富士搖滾攻略</a>
    {topic && (
      <>
        <span> / </span>
        <a href={url(`/fujirock/topic/${topic.id}/`)}>{topic.title}</a>
      </>
    )}
  </p>
  {stageLabel && <p class="frf-kicker">{stageLabel}</p>}
  <h1 class="frf-title">{h1}</h1>
  {article.meta && <p class="frf-lead">{article.meta}</p>}
  {updatedISO && (
    <p class="frf-byline">
      <span>越後飯 ECHIGO FAN</span>
      <span class="sep">·</span>
      <time datetime={updatedISO}>{updatedISO} 最後更新</time>
    </p>
  )}

  {Content ? (
    <article class="frf-prose">
      <Content />
    </article>
  ) : body ? (
    <article class="frf-prose" set:html={body} />
  ) : (
    <p class="frf-note">這篇摘要已上線。全文會在下次 Notion 同步時進來。</p>
  )}

  {(related.length > 0 || showUpgrade) && (
    <nav class="frf-more">
      <p class="frf-more-label">延伸閱讀</p>
      <ol>
        {related.map((a) => (
          <li>
            <a href={url(`/fujirock/${a.slug}/`)}>{displayTitle(a.title)}</a>
          </li>
        ))}
      </ol>
      {topic && (
        <p class="frf-more-back">
          <a href={url(`/fujirock/topic/${topic.id}/`)}>回{topic.title}</a>
        </p>
      )}
      {showUpgrade && (
        <p class="frf-more-back">
          <a href={url('/fujirock/upgrade/')}>回二衝升級</a>
        </p>
      )}
    </nav>
  )}

  <aside class="frf-repost">
    <p>本文原載於 <strong>越後飯 ECHIGO FAN</strong> —— 富士搖滾攻略</p>
    <p>原文網址：<a href={canonical}>{canonical}</a></p>
    <p class="terms">歡迎分享連結。轉載請註明出處並保留原文連結，勿整篇複製。</p>
  </aside>
</Layout>
