---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';
import {
  STAGE_LABEL,
  TOPICS,
  displayTitle,
  articleFromEntry,
  relatedFrom,
  BRIDGE, BRIDGE_SLUGS,
  readMinutes,
  readingOrder,
  isReturnerOnly,
} from '../../lib/frf';
import { FRF_BODIES } from '../../lib/frf-bodies';
import { getCollection, getEntry } from 'astro:content';
import { articleLd, breadcrumbLd, toISODate } from '../../lib/seo';
import { extractFaq, faqLd } from '../../lib/faq';
import { phrase } from '../../lib/phrase';

export async function getStaticPaths() {
  const synced = await getCollection('frf');
  return synced.map((entry) => ({ params: { slug: entry.slug } }));
}

const { slug } = Astro.params;
const entry = await getEntry('frf', slug);
if (!entry) throw new Error('not found');
const article = articleFromEntry(entry);

const synced = await getCollection('frf');
const list = synced.map(articleFromEntry);
const related = relatedFrom(list, article.slug);
const topic = TOPICS.find((t) => t.id === article.topic);
const showUpgrade = isReturnerOnly(article);

const rendered = await entry.render();
const minutes = readMinutes(entry.body);
const SKIP = /懶人重點|延伸閱讀|還有問題|加入我們/;
const heads = (rendered?.headings ?? []).filter((h) => !SKIP.test(h.text));
// 文末的「常見問題」大標不算進「大標夠不夠三個」的判斷，避免攻略文加了 Q&A 之後，目錄從編號小標跳成大標；
// 不管目錄用哪一層，常見問題都排在最後一項。
const FAQ_HEAD = /常見問題/;
const h2s = heads.filter((h) => h.depth === 2 && !FAQ_HEAD.test(h.text));
const faqHead = heads.find((h) => h.depth === 2 && FAQ_HEAD.test(h.text));
// 大標不到三個時，改用帶編號的小標（例如「第一段、第二段」）當目錄
// 1️⃣ 這類編號在渲染時已改成 CSS 徽章、不留在標題文字裡，所以從原始 markdown 找出哪些小標帶編號
const plain = (t: string) => t.replace(/[*_`]/g, '').replace(/\s+/g, ' ').trim();
const stepped = new Set(
  [...(entry.body ?? '').matchAll(/^###\s+(?:\d\uFE0F\u20E3|🔟)\s*(.+)$/gmu)].map((m) => plain(m[1])),
);
const tocSrc = [
  ...(h2s.length >= 3
    ? h2s
    : heads.filter((h) => h.depth === 3 && (stepped.has(plain(h.text)) || /^\s*\d(?:\uFE0F?\u20E3)?(?![\d.．、])/u.test(h.text)))),
  ...(faqHead ? [faqHead] : []),
];
// 只清掉開頭的 emoji、1️⃣ 與「1. 」這類編號（目錄本身會編號）；「2027」這種標題本身的數字要留著
const toc = tocSrc
  .map((h) => ({ slug: h.slug, text: h.text.replace(/^(?:[\p{Extended_Pictographic}\uFE0F\s]|\d\uFE0F?\u20E3)*(?:\d{1,2}[.．、]\s*)?/u, '').trim() || h.text }));
const hasTakeaway = /懶人重點/.test(entry.body ?? '');
const order = readingOrder(list);
const pos = order.findIndex((a) => a.slug === article.slug);
const prevA = pos > 0 ? order[pos - 1] : null;
const nextA = pos >= 0 && pos < order.length - 1 ? order[pos + 1] : null;
// 文章編號（Notion 標題前綴「# 02」）只拿來排序，網站上不顯示：新手、老手篇是同一號的兩欄，顯示出來會像重複。
// 手環上的白色標籤改放閱讀階段。
const Content = rendered?.Content;
const body = Content ? null : FRF_BODIES[article.slug];
const stageLabel = article.stage ? STAGE_LABEL[article.stage] : '';
const canonical = new URL(`/fujirock/${article.slug}/`, Astro.site).href;
const h1 = displayTitle(article.title);
// 搜尋結果標題：有 SEO標題就用，頁面上的 H1 仍是原標題。
// 台灣人多搜「Fuji rock 住宿／交通／門票」（PR #11 的依據），所以 SEO標題沒寫到 Fuji Rock／富士搖滾時，
// 結尾自動補回「Fuji Rock 富士搖滾攻略」。
const FRF_SUFFIX = '｜Fuji Rock 富士搖滾攻略｜越後飯';
const pageTitle = article.seoTitle
  ? (/fuji\s*rock|富士搖滾/i.test(article.seoTitle) ? `${article.seoTitle}｜越後飯` : `${article.seoTitle}${FRF_SUFFIX}`)
  : `${h1}${FRF_SUFFIX}`;

const updated = entry.data.updated;
const updatedISO = updated ? toISODate(updated) : null;

// 這篇如果是 Q&A 體，就順便輸出 FAQPage。抓不到配對會回 null，不硬湊。
const faq = faqLd(extractFaq(entry.body ?? ''));

const ld = [
  articleLd({
    headline: article.seoTitle || h1,
    canonical,
    description: article.meta,
    image: article.image,
    updated,
    section: topic?.title ?? '富士搖滾攻略',
  }),
  faq,
  breadcrumbLd([
    { name: '富士搖滾攻略', url: '/fujirock/' },
    ...(topic ? [{ name: topic.title, url: `/fujirock/topic/${topic.id}/` }] : []),
    { name: h1, url: `/fujirock/${article.slug}/` },
  ]),
].filter(Boolean);

const isBridgePage = BRIDGE_SLUGS.includes(article.slug);
const showBridge = !isBridgePage && !!topic && BRIDGE.topics.includes(topic.id);
// 組合篇已公開就導去組合篇（讀者在這裡想知道的是怎麼排），還沒公開就導去藝術祭主頁
const bridgeTarget = list.find((a) => BRIDGE_SLUGS.includes(a.slug));
const bridgeHref = bridgeTarget ? `/fujirock/${bridgeTarget.slug}/` : BRIDGE.href;
const bridgeLinkText = bridgeTarget ? '富士搖滾＋大地藝術祭 2027 怎麼排' : BRIDGE.linkText;
---
<Layout
  theme="frf"
  title={pageTitle}
  description={article.meta}
  canonical={canonical}
  ogImage={article.image}
  ogType="article"
  jsonLd={ld}
  progress
  pageClass={isBridgePage ? 'frf-bridge-page' : ''}
>
  {isBridgePage && (
    <p class="frf-bridge-band" aria-label="富士搖滾與大地藝術祭">
      <a href={url('/fujirock/')}>富士搖滾</a>
      <span aria-hidden="true">×</span>
      <a href={url('/art-field/')}>大地藝術祭</a>
    </p>
  )}
  <p class="frf-crumb">
    <a href={url('/fujirock/')}>富士搖滾攻略</a>
    {isBridgePage && (
      <>
        <span> / </span>
        <a href={url('/art-field/')}>大地藝術祭 2027</a>
      </>
    )}
    {!isBridgePage && topic && (
      <>
        <span> / </span>
        <a href={url(`/fujirock/topic/${topic.id}/`)}>{topic.title}</a>
      </>
    )}
  </p>
  {stageLabel && <p class="frf-kicker">{stageLabel}</p>}
  <h1 class="frf-title" set:html={phrase(h1)} />
  {article.meta && <p class="frf-lead">{article.meta}</p>}
  {updatedISO && (
    <p class="frf-byline">
      <span>文／阿飯</span>
      <span class="sep">·</span>
      <span>越後飯 ECHIGO FAN</span>
      <span class="sep">·</span>
      <time datetime={updatedISO}>{updatedISO} 最後更新</time>
    </p>
  )}

  <p class="frf-chips">
    {!/閱讀時間/.test(entry.body ?? '') && <span class="frf-chip">約 {minutes} 分鐘</span>}
    {hasTakeaway && <a class="frf-chip frf-chip--go" href="#takeaway">先看懶人重點 ↓</a>}
  </p>

  {entry.data.glance && entry.data.glance.length > 0 && (
    <aside class="frf-glance" aria-label="速覽">
      <p class="frf-glance-label">速覽</p>
      <ul>{entry.data.glance.map((g) => <li>{g}</li>)}</ul>
    </aside>
  )}

  {toc.length >= 3 && (
    <details class="frf-tocbox" open>
      <summary>本篇目錄</summary>
      <ol>
        {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
      </ol>
    </details>
  )}

  {Content ? (
    <article class="frf-prose">
      <Content />
    </article>
  ) : body ? (
    <article class="frf-prose" set:html={body} />
  ) : (
    <p class="frf-note">這篇摘要已上線。全文會在下次 Notion 同步時進來。</p>
  )}

  <nav class="frf-band" aria-label="上一篇與下一篇">
    <div class="frf-band-strap" aria-hidden="true">
      <span class="frf-band-logo">FUJI ROCK</span>
      {stageLabel && <span class="frf-band-no">{stageLabel}</span>}
      <span class="frf-band-topic">{topic?.title ?? '富士搖滾攻略'}</span>
      <span class="frf-band-snap"></span>
    </div>
    <div class="frf-band-links">
      {prevA ? (
        <a class="prev" href={url(`/fujirock/${prevA.slug}/`)}><span>← 上一篇</span><strong>{displayTitle(prevA.title)}</strong></a>
      ) : <span></span>}
      {nextA ? (
        <a class="next" href={url(`/fujirock/${nextA.slug}/`)}><span>下一篇 →</span><strong>{displayTitle(nextA.title)}</strong></a>
      ) : <span></span>}
    </div>
  </nav>

  {showBridge && (
    <aside class="frf-bridge">
      <p class="frf-more-label">{BRIDGE.label}</p>
      <p class="frf-bridge-title">{BRIDGE.title}</p>
      <p>{BRIDGE.text}</p>
      <p><a href={url(bridgeHref)}>{bridgeLinkText} →</a></p>
    </aside>
  )}

  {(related.length > 0 || showUpgrade) && (
    <nav class="frf-more">
      <p class="frf-more-label">延伸閱讀</p>
      <ol>
        {related.map((a) => (
          <li>
            <a href={url(`/fujirock/${a.slug}/`)}>{displayTitle(a.title)}</a>
          </li>
        ))}
      </ol>
      {topic && (
        <p class="frf-more-back">
          <a href={url(`/fujirock/topic/${topic.id}/`)}>回{topic.title}</a>
        </p>
      )}
      {showUpgrade && (
        <p class="frf-more-back">
          <a href={url('/fujirock/upgrade/')}>回二衝升級</a>
        </p>
      )}
    </nav>
  )}

  <aside class="frf-repost">
    <p>本文原載於 <strong>越後飯 ECHIGO FAN</strong> —— 富士搖滾攻略</p>
    <p>原文網址：<a href={canonical}>{canonical}</a></p>
    <p class="terms">歡迎分享連結。轉載請註明出處並保留原文連結，勿整篇複製。</p>
  </aside>
<script is:inline>
    // 固定參考圖：內文裡有 data-pin 的圖（Notion 圖片說明以 📍 開頭）
    (() => {
      const img = document.querySelector('.frf-prose img[data-pin]');
      if (!img) return;
      const src = img.getAttribute('src');
      const alt = img.getAttribute('alt') || '參考圖';
  
      // 放大檢視：點圖在「符合螢幕」與「放大兩倍、可拖曳捲動」之間切換
      const dlg = document.createElement('dialog');
      dlg.className = 'frf-pinmap-dlg';
      dlg.setAttribute('aria-label', alt);
      dlg.innerHTML = '<div class="frf-pinmap-bar"><span></span><button type="button" class="frf-pinmap-x" aria-label="關閉">✕</button></div><div class="frf-pinmap-view"><img alt=""></div>';
      dlg.querySelector('.frf-pinmap-bar span').textContent = alt + '（點圖放大）';
      const big = dlg.querySelector('img');
      big.src = src; big.alt = alt;
      big.addEventListener('click', () => dlg.classList.toggle('zoomed'));
      dlg.querySelector('.frf-pinmap-x').addEventListener('click', () => dlg.close());
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('close', () => dlg.classList.remove('zoomed'));
      document.body.appendChild(dlg);
      const open = () => dlg.showModal();
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', open);
  
      // 電腦：縮圖固定在「本篇目錄」下面
      const toc = document.querySelector('.frf-tocbox');
      if (toc) {
        const side = document.createElement('button');
        side.type = 'button';
        side.className = 'frf-pinmap-side';
        side.innerHTML = '<img alt=""><span></span>';
        side.querySelector('img').src = src;
        side.querySelector('img').alt = alt;
        side.querySelector('span').textContent = alt + '，點圖放大';
        side.addEventListener('click', open);
        toc.appendChild(side);
        document.documentElement.classList.add('has-pinmap-side');
      }
  
      // 手機與平板：捲過原圖之後，右下角出現「看地圖」
      const fab = document.createElement('button');
      fab.type = 'button';
      fab.className = 'frf-pinmap-fab';
      fab.textContent = '🗺 看地圖';
      fab.setAttribute('aria-label', '看' + alt);
      fab.addEventListener('click', open);
      document.body.appendChild(fab);
      new IntersectionObserver(([en]) => {
        fab.classList.toggle('on', !en.isIntersecting && en.boundingClientRect.top < 0);
      }).observe(img);
    })();
  </script>
</Layout>


<style is:global>
  .frf-pinmap-side { display: none; }
  @media (min-width: 1240px) {
    .frf-pinmap-side {
      display: block; width: 100%; margin: 14px 0 0; padding: 0;
      border: 0; background: none; text-align: left; cursor: zoom-in;
    }
    .frf-pinmap-side img { display: block; width: 100%; border-radius: 4px; border: 1px solid var(--line); }
    .frf-pinmap-side span { display: block; margin-top: 4px; font-size: 12px; color: var(--ink-soft); }
    .has-pinmap-side .frf-pinmap-fab { display: none !important; }
  }
  .frf-pinmap-fab {
    position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 50; padding: 10px 16px; min-height: 44px;
    border: 1px solid var(--line); border-radius: 999px;
    background: var(--paper); color: var(--ink); font: inherit; font-size: 14px; font-weight: 700;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .15); cursor: pointer;
    opacity: 0; transform: translateY(8px); pointer-events: none;
    transition: opacity .2s ease, transform .2s ease;
  }
  .frf-pinmap-fab.on { opacity: 1; transform: none; pointer-events: auto; }
  .frf-pinmap-dlg {
    width: 100vw; max-width: 100vw; height: 100dvh; max-height: 100dvh;
    margin: 0; padding: 0; border: 0; background: var(--paper);
  }
  .frf-pinmap-dlg::backdrop { background: rgba(0, 0, 0, .55); }
  .frf-pinmap-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    height: 52px; padding: 0 8px 0 16px; border-bottom: 1px solid var(--line);
    font-size: 14px; color: var(--ink-soft);
  }
  .frf-pinmap-x { min-width: 44px; min-height: 44px; border: 0; background: none; font-size: 20px; color: var(--ink); cursor: pointer; }
  .frf-pinmap-view { height: calc(100% - 53px); overflow: auto; display: grid; place-items: center; }
  .frf-pinmap-view img { max-width: 100%; max-height: 100%; cursor: zoom-in; }
  .frf-pinmap-dlg.zoomed .frf-pinmap-view { display: block; }
  .frf-pinmap-dlg.zoomed .frf-pinmap-view img { max-width: none; max-height: none; width: 200%; cursor: zoom-out; }
  @media (min-width: 900px) { .frf-pinmap-dlg.zoomed .frf-pinmap-view img { width: auto; } }
  @media (prefers-reduced-motion: reduce) { .frf-pinmap-fab { transition: none; } }
</style>

<style>
  .frf-bridge {
    margin: 2.5rem 0 1.5rem;
    padding: 1.25rem 1.25rem 1rem;
    border-left: 3px solid var(--naeba, #3f7a4a);
    background: color-mix(in srgb, var(--naeba, #3f7a4a) 7%, transparent);
  }
  .frf-bridge p { margin: 0 0 .6rem; }
  .frf-bridge .frf-more-label { color: var(--ink); }
  .frf-bridge-title { font-weight: 700; font-size: 1.1rem; }
</style>
