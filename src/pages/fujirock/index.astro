---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';
import {
  START_PATH,
  TOPICS,
  displayTitle,
  articleFromEntry,
  articlesByTopicFrom,
  upgradeFrom,
} from '../../lib/frf';
import { getCollection } from 'astro:content';

const FB = 'https://www.facebook.com/groups/119131948168427';
const LINE =
  'https://line.me/ti/g2/ZkbbX0AKZnX8QU0_fg3LBxGMNorVV_gw942nSg?utm_source=invitation&utm_medium=link_copy&utm_campaign=default';
const LINE_OA = 'https://lin.ee/R12Vd62';
const LINE_BTN = 'https://scdn.line-apps.com/n/line_add_friends/btn/zh-Hant.png';
const canonical = new URL('/fujirock/', Astro.site).href;
const synced = await getCollection('frf');
const list = synced.map(articleFromEntry);
const bySlug = Object.fromEntries(list.map((a) => [a.slug, a]));
const topics = TOPICS.map((topic) => {
  const items = articlesByTopicFrom(list, topic.id);
  const preview = topic.preview
    .map((slug) => bySlug[slug])
    .filter(Boolean)
    .map((a) => ({ slug: a.slug, title: displayTitle(a.title) }));
  return { ...topic, count: items.length, preview };
});
const upgradeCount = upgradeFrom(list).length;

const NEXT_FRF = new Date('2027-07-23T00:00:00+09:00');
const FRF_END = new Date('2027-07-26T00:00:00+09:00');
const now = Date.now();
const daysLeft = Math.ceil((NEXT_FRF.getTime() - now) / 86400000);
const isLive = now >= NEXT_FRF.getTime() && now < FRF_END.getTime();
---
<Layout
  theme="frf"
  title="富士搖滾攻略｜Fuji Rock Festival 苗場｜越後飯"
  description="台灣人看的富士搖滾音樂祭（Fuji Rock Festival）攻略：東京到苗場交通、露營、預算、裝備。2027 年 7 月 23–25 日在新潟苗場，不是富士山。"
  canonical={canonical}
  ogImage="/images/frf/og.jpg"
>
  <section slot="hero" class="frf-hero">
    <img src={url('/images/frf/stage-rain.jpg')} alt="富士搖滾苗場會場雨中舞台" />
    <div class="frf-hero-mask"></div>
    <div class="frf-hero-copy">
      <p class="kicker">FUJI ROCK FESTIVAL</p>
      <h1>富士搖滾</h1>
      <p>日本夏季在新潟苗場辦的戶外音樂祭。第一次去、第二次想住得舒服，或報了團也要自己準備，從交通跟裝備看起。</p>
    </div>
  </section>

  {daysLeft > 0 && (
    <p class="frf-count-line">還有 <strong>{daysLeft}</strong> 天開幕，2027/7/23–25 苗場</p>
  )}
  {isLive && <p class="frf-count-line">苗場開演中</p>}

  <p class="frf-kicker">第一次去？</p>
  <h2 class="frf-section">從這三篇開始</h2>
  <p class="frf-note">照順序讀完，會知道要不要去、花多少錢、怎麼到。</p>
  <ol class="frf-toc">
    {START_PATH.map((item, i) => (
      <li>
        <a href={url(`/fujirock/${item.slug}/`)}>
          <span class="n">{i + 1}</span>
          <span>
            <strong>{item.title}</strong>
            <em>{item.note}</em>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <p class="frf-kicker">想解決什麼？</p>
  <div class="frf-index">
    {topics.map((topic) => (
      <section>
        <a class="frf-index-head" href={url(`/fujirock/topic/${topic.id}/`)}>
          <strong>{topic.title}</strong>
          <span>{topic.count} 篇</span>
        </a>
        <ol>
          {topic.preview.map((item) => (
            <li>
              <a href={url(`/fujirock/${item.slug}/`)}>{item.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <p class="frf-upgrade">
    <a href={url('/fujirock/upgrade/')}>去過一次了？免搭帳、住宿、裝備輕量化 — {upgradeCount} 篇 →</a>
  </p>

  <div class="frf-community" id="community">
    <a href={FB} target="_blank" rel="noopener"><span class="mob">臉書社團</span><span class="desk">加入台灣民間總部臉書社團</span></a>
    <a href={LINE} target="_blank" rel="noopener">LINE 社群</a>
    <a class="frf-line-oa" href={LINE_OA} target="_blank" rel="noopener">
      <img class="frf-line-btn" src={LINE_BTN} width="116" height="36" alt="加入富搖小幫手" />
      <span class="frf-line-id">富搖小幫手 @800dbehr</span>
    </a>
  </div>

  <p class="frf-back"><a href={url('/')}>← 回越後飯</a></p>
</Layout>
