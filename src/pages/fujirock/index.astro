---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';

const FB_GROUP = 'https://www.facebook.com/groups/119131948168427';
const LINE_URL = 'https://line.me/ti/g2/ZkbbX0AKZnX8QU0_fg3LBxGMNorVV_gw942nSg?utm_source=invitation&utm_medium=link_copy&utm_campaign=default';

const firstFour = [
  {
    n: '01',
    title: '富士搖滾新手 Q&A',
    desc: '門票、預算、交通、露營最常問的問題。',
    slug: 'beginner-faq',
  },
  {
    n: '02',
    title: '行前準備',
    desc: '機票、住宿、岩盤買票順序。',
    slug: 'before-you-go',
  },
  {
    n: '03',
    title: '上野→湯澤→苗場',
    desc: '新幹線、接駁車、行李與時刻表。',
    slug: 'tokyo-to-naeba',
  },
  {
    n: '04',
    title: '露營還是民宿',
    desc: '斜坡、暴雨、洗澡。住哪種之前先看真相。',
    slug: 'camping-reality',
  },
];
---

<Layout
  theme="frf"
  title="富士搖滾 Fuji Rock 攻略｜苗場・越後湯澤｜越後飯"
  description="第一次衝、第二次想舒服、報了團也要自己準備。台灣人版富士搖滾攻略：行前、交通、住宿、裝備。"
>
  <p class="frf-kicker">FUJI ROCK GUIDE</p>
  <h1 class="frf-title">富士搖滾</h1>
  <p class="frf-lead">第一次衝、第二次想舒服、報了團也要自己準備。</p>

  <div class="frf-count" id="frf-count" hidden>
    <span class="frf-count-num" id="frf-days">—</span>
    <span class="frf-count-unit">天</span>
    <span class="frf-count-label" id="frf-count-label">距 2027 開幕</span>
  </div>

  <div class="frf-doors">
    <section class="frf-door beginner">
      <h2>新手首衝</h2>
      <p>行前 · 交通 · 預算 · 裝備</p>
    </section>
    <section class="frf-door returner">
      <h2>二衝升級</h2>
      <p>免搭帳 · 指定席 · 露營分區</p>
    </section>
  </div>

  <div class="frf-community" id="community">
    <a href={FB_GROUP} target="_blank" rel="noopener">加入台灣民間總部臉書社團</a>
    <span class="sep">｜</span>
    <a href={LINE_URL} target="_blank" rel="noopener">LINE 社群</a>
  </div>

  <div class="section-label">先看這四篇</div>
  <ol class="frf-first">
    {firstFour.map((item) => (
      <li>
        <span class="n">{item.n}</span>
        <div>
          <strong>{item.title}</strong>
          <p>{item.desc}</p>
          <span class="soon">文章尚未同步上站 · /fujirock/{item.slug}/</span>
        </div>
      </li>
    ))}
  </ol>

  <p class="frf-back">
    <a href={url('/')}>← 回越後飯</a>
  </p>

  <script is:inline>
    // 下一屆開幕日。官方正式公布後改這一行。
    // 2027 目前是現場公布的 7/23（五）～7/25（日），還沒有官網正式頁面。
    const NEXT_FRF = new Date('2027-07-23T00:00:00+09:00');
    const daysLeft = Math.ceil((NEXT_FRF.getTime() - Date.now()) / 86400000);
    const box = document.getElementById('frf-count');
    const num = document.getElementById('frf-days');
    const label = document.getElementById('frf-count-label');
    if (box && num && label) {
      if (daysLeft > 0) {
        num.textContent = String(daysLeft);
        label.textContent = '距 2027.7.23 開幕（尚未官宣）';
        box.hidden = false;
      } else if (daysLeft > -3) {
        num.textContent = 'NOW';
        num.classList.add('is-now');
        label.textContent = '今屆進行中';
        box.hidden = false;
      }
    }
  </script>
</Layout>
