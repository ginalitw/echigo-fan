---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/url';
import { DOORS, FEATURED, TOPICS, displayTitle, articleFromEntry } from '../../lib/frf';
import { getCollection } from 'astro:content';

const FB = 'https://www.facebook.com/groups/119131948168427';
const LINE =
  'https://line.me/ti/g2/ZkbbX0AKZnX8QU0_fg3LBxGMNorVV_gw942nSg?utm_source=invitation&utm_medium=link_copy&utm_campaign=default';
const LINE_OA = 'https://lin.ee/R12Vd62';
const LINE_BTN = 'https://scdn.line-apps.com/n/line_add_friends/btn/zh-Hant.png';
const canonical = new URL('/fujirock/', Astro.site).href;
const synced = await getCollection('frf');
const bySlug = Object.fromEntries(synced.map((e) => [e.slug, articleFromEntry(e)]));
const featured = FEATURED.map((item) => {
  const live = bySlug[item.slug];
  return {
    ...item,
    title: live ? displayTitle(live.title) : item.title,
    desc: live?.meta || item.desc,
  };
});
const topics = TOPICS.map((topic) => ({
  ...topic,
  items: topic.slugs
    .map((slug) => {
      const live = bySlug[slug];
      if (!live) return null;
      return { slug, title: displayTitle(live.title) };
    })
    .filter((x): x is { slug: string; title: string } => Boolean(x)),
}));
---
<Layout
  theme="frf"
  title="富士搖滾攻略｜Fuji Rock Festival 苗場｜越後飯"
  description="台灣人看的富士搖滾音樂祭（Fuji Rock Festival）攻略：東京到苗場交通、露營、預算、裝備。2027 年 7 月 23–25 日在新潟苗場，不是富士山。"
  canonical={canonical}
  ogImage="/images/frf/og.jpg"
>
  <section slot="hero" class="frf-hero">
    <img src={url('/images/frf/stage-rain.jpg')} alt="富士搖滾苗場會場雨中舞台" />
    <div class="frf-hero-mask"></div>
    <div class="frf-hero-copy">
      <p class="kicker">FUJI ROCK FESTIVAL</p>
      <h1>富士搖滾</h1>
      <p>日本夏季在新潟苗場辦的戶外音樂祭。第一次去、第二次想住得舒服，或報了團也要自己準備，從交通跟裝備看起。</p>
    </div>
  </section>

  <div class="frf-count" id="frf-count" hidden>
    <span class="frf-count-num" id="frf-days">—</span>
    <span class="frf-count-unit">天</span>
    <span class="frf-count-label" id="frf-count-label">距 2027/7/23–25 開幕</span>
  </div>

  <p class="frf-kicker">依你是誰</p>
  <div class="frf-doors">
    {DOORS.map((door) => (
      <a class={`frf-door ${door.id}`} href={url(`/fujirock/audience/${door.id}/`)}>
        <p class="label">{door.title}</p>
        <p class="desc">{door.desc}</p>
      </a>
    ))}
  </div>

  <h2 class="frf-section">先看這四篇</h2>
  <ol class="frf-first">
    {featured.map((item) => (
      <li>
        <a href={url(`/fujirock/${item.slug}/`)}>
          <strong>{item.title}</strong>
          <p>{item.desc}</p>
        </a>
      </li>
    ))}
  </ol>

  <h2 class="frf-section" id="topics">依你要查什麼</h2>
  <div class="frf-topics">
    {topics.map((topic) => (
      <section class="frf-topic">
        <h3>{topic.title}</h3>
        <ol>
          {topic.items.map((item) => (
            <li>
              <a href={url(`/fujirock/${item.slug}/`)}>{item.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  <div class="frf-community" id="community">
    <a href={FB} target="_blank" rel="noopener"><span class="mob">臉書社團</span><span class="desk">加入台灣民間總部臉書社團</span></a>
    <a href={LINE} target="_blank" rel="noopener">LINE 社群</a>
    <a class="frf-line-oa" href={LINE_OA} target="_blank" rel="noopener">
      <img class="frf-line-btn" src={LINE_BTN} width="116" height="36" alt="加入富搖小幫手" />
      <span class="frf-line-id">富搖小幫手 @800dbehr</span>
    </a>
  </div>

  <p class="frf-back"><a href={url('/')}>← 回越後飯</a></p>
</Layout>

<script is:inline>
  const NEXT_FRF = new Date('2027-07-23T00:00:00+09:00');
  const daysLeft = Math.ceil((NEXT_FRF.getTime() - Date.now()) / 86400000);
  const box = document.getElementById('frf-count');
  const num = document.getElementById('frf-days');
  const label = document.getElementById('frf-count-label');
  if (box && num && label) {
    if (daysLeft > 0) {
      num.textContent = String(daysLeft);
      box.hidden = false;
    } else if (daysLeft > -3) {
      num.textContent = 'NOW';
      label.textContent = '2027/7/23–25 進行中';
      box.hidden = false;
    }
  }
</script>
