---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/url';
---
<Layout title="迷路了｜越後飯 ECHIGO FAN" description="這一頁不在路線上。" pageClass="page-article">
  <section class="lost">
    <div>
      <p class="code">404</p>
      <h1>這一站<wbr />不在路線上。</h1>
      <p>可能是網址打錯，或是這篇已經換了地方。阿飯也常常走錯田埂，繞回來就好。</p>
      <div class="links">
        <a class="text-link" href={url('/')}>回越後飯首頁 <span aria-hidden="true">→</span></a>
        <a class="text-link" href={url('/fujirock/')}>富士搖滾攻略 <span aria-hidden="true">→</span></a>
        <a class="text-link" href={url('/archive/')}>全部文章 <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure>
      <img
        src={url('/images/about/afan-tanada.webp')}
        srcset={`${url('/images/about/afan-tanada-480.webp')} 480w, ${url('/images/about/afan-tanada-800.webp')} 800w, ${url('/images/about/afan-tanada.webp')} 1600w`}
        sizes="(max-width: 760px) 100vw, 50vw"
        width="1600" height="893"
        alt="阿飯站在梯田的田埂上，望向遠方"
      />
    </figure>
  </section>
</Layout>
