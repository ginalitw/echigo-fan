---
import { url } from '../lib/url';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const published = allPosts.filter(p => p.data.status !== '待填');

const categories = [
  { key: '越後大地藝術祭', icon: '📕', cls: 'art', desc: '越後妻有的作品、路線、官方一日遊——我實際走過的部分。', image: '/images/cat-art.jpg' },
  { key: '富士搖滾二三事', icon: '🎸', cls: 'frf', desc: '舞台之外，還有更多故事。', image: '/images/cat-frf.jpg' },
  { key: '我吃的不只是飯', icon: '🍚', cls: 'rice', desc: '米、酒、山菜、車站便當。吃過才寫。', image: '/images/cat-rice.jpg' },
  { key: '里山人文和風土', icon: '❄️', cls: 'season', desc: '雪、織物、土地的故事。查得到的知識，我用自己的方式消化。', image: '/images/cat-season.jpg' },
];

function countFor(key) {
  return published.filter(p => p.data.category.includes(key)).length;
}
---
<Layout title="越後飯 ECHIGO FAN">
  <div class="wave"></div>
  <div class="section-label">走過的路，四個方向</div>
  <div class="cats">
    {categories.map(c => (
      <a
        class={`cat ${c.cls} ${c.image ? '' : 'no-image'}`}
        href={url(`/category/${encodeURIComponent(c.key)}`)}
        style={c.image ? `background-image:url(${url(c.image)})` : ''}
      >
        <div class="cat-inner">
          <h3>{c.icon} {c.key}</h3>
          <p>{c.desc}</p>
          <div class="count">收錄 {countFor(c.key)} 篇</div>
        </div>
      </a>
    ))}
  </div>

  <div class="wave"></div>
  <div class="section-label">最新行腳</div>
  <div class="posts">
    {published.map(post => (
      <a class="post-row" href={url(`/posts/${post.slug}`)}>
        <div class="meta">
          {post.data.season && post.data.season.length > 0 && (
            <span class="season">{post.data.season[0]}</span>
          )}<br />
          {post.data.location}<br />
          {post.data.artworkNumber}
        </div>
        <div class="body">
          <h4>{post.data.title}{post.data.postType && <span class="tag">{post.data.postType}</span>}</h4>
          <p>{post.data.lead}</p>
        </div>
      </a>
    ))}
  </div>
</Layout>
