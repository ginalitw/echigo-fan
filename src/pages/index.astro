---
import { url } from '../lib/url';
import { byNewest, formatDate } from '../lib/posts';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const published = allPosts.filter(p => p.data.status !== '待填');

// 列表一律「新的在上面」，跟四個分類頁一致。
// 註：閱讀動線（上一站／下一站）仍然由排序碼決定，跟這裡的顯示順序無關。
const ordered = [...published].sort(byNewest);

// 首頁只放最新幾篇，其餘走「全部文章」或四個方向。
// 首頁不做分頁——第 2 頁會把上面的品牌區、四張卡整組再重複一次，很奇怪。
const HOME_LIMIT = 5;
const homePosts = ordered.slice(0, HOME_LIMIT);
const hasMore = ordered.length > HOME_LIMIT;

// 分類卡的背景圖：自動取用該分類「最新一篇」的首圖，沒有就退回預設圖。
// 這樣你在 Notion 發新文章，首頁的四張卡會自己換上新照片，完全不用維護。
function newestCover(key) {
  const hit = published
    .filter((p) => p.data.category?.includes(key) && p.data.cover)
    .sort((a, b) => {
      const ad = a.data.date ? +new Date(a.data.date) : 0;
      const bd = b.data.date ? +new Date(b.data.date) : 0;
      if (ad !== bd) return bd - ad;                                   // 新的排前面
      return String(b.data.code || '').localeCompare(String(a.data.code || ''));
    })[0];
  return hit?.data.cover || null;
}

const categories = [
  { key: '越後大地藝術祭', icon: '📕', cls: 'art', desc: '越後妻有的作品、路線、官方一日遊——我實際走過的部分。', fallback: '/images/cat-art.jpg' },
  { key: '富士搖滾二三事', icon: '🎸', cls: 'frf', desc: '舞台之外，還有更多故事。', fallback: '/images/cat-frf.jpg' },
  { key: '我吃的不只是飯', icon: '🍚', cls: 'rice', desc: '米、酒、山菜、車站便當。吃過才寫。', fallback: '/images/cat-rice.jpg' },
  { key: '里山人文和風土', icon: '❄️', cls: 'season', desc: '雪、織物、土地的故事。查得到的知識，我用自己的方式消化。', fallback: '/images/cat-season.jpg' },
].map((c) => ({ ...c, image: newestCover(c.key) || c.fallback }));

function countFor(key) {
  return published.filter(p => p.data.category.includes(key)).length;
}
---
<Layout title="越後飯 ECHIGO FAN">
  <div class="wave"></div>
  <div class="section-label">四個方向</div>
  <div class="cats">
    {categories.map(c => (
      <a
        class={`cat ${c.cls} ${c.image ? '' : 'no-image'}`}
        href={url(`/category/${encodeURIComponent(c.key)}`)}
        style={c.image ? `background-image:url(${url(c.image)})` : ''}
      >
        <div class="cat-inner">
          <h3>{c.icon} {c.key}</h3>
          <p>{c.desc}</p>
          <div class="count">收錄 {countFor(c.key)} 篇</div>
        </div>
      </a>
    ))}
  </div>

  <div class="wave"></div>
  <div class="section-label">走過的路</div>
  <div class="posts">
    {homePosts.map(post => (
      <a class="post-row" href={url(`/posts/${post.slug}`)}>
        <div class="meta">
          {post.data.date && <span class="date">{formatDate(post.data.date)}</span>}<br />
          {post.data.season && post.data.season.length > 0 && (
            <span class="season">{post.data.season[0]}</span>
          )}<br />
          {post.data.location}<br />
          {post.data.artworkNumber}
        </div>
        <div class="body">
          <h4>{post.data.title}{post.data.postType && <span class="tag">{post.data.postType}</span>}</h4>
          <p>{post.data.lead}</p>
        </div>
      </a>
    ))}
  </div>
  {hasMore && (
    <p class="more-link">
      <a href={url('/archive')}>看全部 {ordered.length} 篇 ▶</a>
    </p>
  )}
</Layout>
