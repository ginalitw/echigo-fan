---
import { byNewest } from '../lib/posts';
import ListPage from '../components/ListPage.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.filter((p) => p.data.status !== '待填').sort(byNewest);
---
<ListPage title="全部文章" eyebrow="Archive" intro="走過的每一站，新的在前面。" posts={posts} canonicalPath="/archive/" />
