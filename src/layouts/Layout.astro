---
import { url } from '../lib/url';
import '../styles/global.css';
import '../styles/frf.css';

const {
  title = '越後飯 ECHIGO FAN',
  canonical,
  theme = 'echigo',
  description,
  ogImage,
} = Astro.props;

const isFrf = theme === 'frf';
const FB = 'https://www.facebook.com/groups/119131948168427';
const site = Astro.site ? Astro.site.href : 'https://echigo.fans/';
const abs = (path) => new URL(path, site).href;
const shareImage = ogImage ? abs(ogImage) : isFrf ? abs('/images/frf/og.jpg') : undefined;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {description && <meta property="og:title" content={title} />}
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {shareImage && <meta property="og:image" content={shareImage} />}
  <meta property="og:locale" content="zh_TW" />
  <meta name="theme-color" content={isFrf ? '#3F7A4A' : '#D9A03C'} />

  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WV5P4V2MWM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-WV5P4V2MWM');
  </script>
</head>
<body class={isFrf ? 'theme-frf' : ''}>
  {isFrf ? (
    <header class="site-header frf-top">
      <div class="frf-bar wrap">
        <a class="brand" href={url('/')}>越後飯<span class="en">ECHIGO FAN</span></a>
        <nav class="site-nav">
          <a href={url('/')}>越後飯</a>
          <a href={url('/fujirock/')} class="is-active">音樂祭</a>
          <a href={FB} target="_blank" rel="noopener">社團</a>
        </nav>
      </div>
    </header>
  ) : (
    <header class="site-header">
      <div class="brand">越後飯<span class="en">ECHIGO FAN</span></div>
      <div class="tagline serif">是新潟的鐵粉，也吃新潟的飯。</div>
      <div class="slogan">追過了，才帶你去</div>
      <div class="site-nav">
        <a href={url('/')} class="is-active">越後飯</a>
        <a href={url('/fujirock/')}>音樂祭</a>
        <a href="https://www.threads.net/@echigo.fan" target="_blank" rel="noopener">Threads</a>
        <a href="https://www.instagram.com/echigo.fan" target="_blank" rel="noopener">Instagram</a>
      </div>
    </header>
  )}

  <slot name="hero" />

  <main class="wrap">
    <slot />
  </main>

  <footer class="site-footer">
    {isFrf ? '越後飯 · 音樂祭 · 富士搖滾攻略' : '越後飯 ECHIGO FAN · 追過了，才帶你去 · 繁體中文'}
  </footer>
</body>
</html>
