---
import { url } from '../lib/url';
import '../styles/global.css';
const { title = '越後飯 ECHIGO FAN', canonical } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}

  <!-- Google Analytics (GA4)。評估 ID 不是機密，本來就會出現在網頁原始碼裡。
       記得在 GA 後台設定「內部流量排除」濾掉自己的 IP，否則數據會被自己的瀏覽灌水。 -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WV5P4V2MWM"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-WV5P4V2MWM');
  </script>
</head>
<body>
  <header class="site-header">
    <div class="brand">越後飯<span class="en">ECHIGO FAN</span></div>
    <div class="tagline serif">是新潟的鐵粉，也吃新潟的飯。</div>
    <div class="slogan">追過了，才帶你去</div>
    <div class="site-nav">
      <a href={url('/')}>首頁</a>
      <a href="https://www.threads.net/@echigo.fan" target="_blank" rel="noopener">Threads</a>
      <a href="https://www.instagram.com/echigo.fan" target="_blank" rel="noopener">Instagram</a>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="site-footer">越後飯 ECHIGO FAN · 追過了，才帶你去 · 繁體中文</footer>
</body>
</html>
